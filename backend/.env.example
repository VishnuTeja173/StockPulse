# ============================================
# StockPulse Environment Variables
# ============================================

# Google Gemini API (FREE - get at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (FREE - get at https://supabase.com)
# Optional: only needed if you want persistent storage
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# App Config
PORT=8000
ENV=development
